{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0merUfuk/mercury/contracts/plan.schema.json",
  "title": "Mercury groomed plan (Phase 2 output / POST /plan response)",
  "description": "The full ticket tree emitted after grooming. Parent links and milestones preserve the approved skeleton; scores are attached by the harness after the judge runs and are absent until then.",
  "type": "object",
  "required": ["plan_id", "requester", "role_lens", "mode", "epic", "milestones", "items"],
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "requester": { "type": "string", "minLength": 1 },
    "role_lens": { "enum": ["business", "tech"] },
    "mode": { "enum": ["front_door", "groom_existing"] },
    "epic": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["temp_id", "summary", "why"],
          "additionalProperties": false,
          "properties": {
            "temp_id": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "why": { "type": "string", "minLength": 1 },
            "existing_key": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" }] }
          }
        }
      ]
    },
    "milestones": { "$ref": "skeleton.schema.json#/properties/milestones" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["temp_id", "type", "parent_temp_id", "depends_on", "milestone_id", "repo", "effort_tier", "predicted_cost_usd", "fields"],
        "additionalProperties": false,
        "properties": {
          "temp_id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["Story", "Task", "Feature", "Request", "Bug", "Test", "Sub-task"] },
          "parent_temp_id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
          "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "milestone_id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
          "repo": {
            "enum": ["web-app", "api-service", "worker-service", "shared-lib", "cross-repo-lockstep"]
          },
          "effort_tier": { "enum": ["low", "medium", "high", "max"] },
          "predicted_cost_usd": { "type": "number", "minimum": 0 },
          "fields": {
            "type": "object",
            "required": ["why", "related_links", "definition_of_done", "technical_analysis", "acceptance_criteria"],
            "additionalProperties": false,
            "properties": {
              "why": { "type": "string", "minLength": 1, "description": "prose (output language, default English) — intent, problem + user value" },
              "related_links": {
                "type": "object",
                "required": ["external", "code_anchors"],
                "additionalProperties": false,
                "properties": {
                  "external": { "type": "array", "items": { "type": "string" } },
                  "code_anchors": { "type": "array", "items": { "type": "string", "description": "repo:path[:symbol]" } }
                }
              },
              "definition_of_done": { "type": "string", "minLength": 1, "description": "output language (default English) — concrete + testable" },
              "technical_analysis": {
                "type": "object",
                "required": ["prose", "affected_repos", "coupling_zones", "tier1_decomposition", "read_only_repos"],
                "additionalProperties": false,
                "properties": {
                  "prose": { "type": "string", "minLength": 1, "description": "prose in output language (default English); technical jargon always English" },
                  "affected_repos": { "type": "array", "items": { "type": "string" } },
                  "coupling_zones": { "type": "array", "items": { "enum": ["none", "shared-write"] } },
                  "tier1_decomposition": { "enum": ["single-repo-sequenced", "needs-human"] },
                  "read_only_repos": { "type": "array", "items": { "type": "string" } },
                  "inferred_repos_flagged": {
                    "type": "boolean",
                    "description": "true when affected repos were inferred (not requester-supplied) and need human confirmation"
                  }
                }
              },
              "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "score": {
            "type": "object",
            "description": "attached by the harness after the judge pass (weighted /100 computed in code, never by the LLM)",
            "required": ["total", "by_field", "verdict"],
            "additionalProperties": false,
            "properties": {
              "total": { "type": "number", "minimum": 0, "maximum": 100 },
              "by_field": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 } },
              "verdict": { "enum": ["PASS", "FLAG", "BLOCK"] }
            }
          }
        }
      }
    },
    "tree_score": {
      "type": "object",
      "description": "tree-level grade attached by the harness",
      "required": ["total", "by_dimension", "verdict"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number", "minimum": 0, "maximum": 100 },
        "by_dimension": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 } },
        "verdict": { "enum": ["PASS", "FLAG", "BLOCK"] }
      }
    }
  }
}
